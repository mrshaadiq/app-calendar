{
  "name": "functions",
  "scripts": {
    "lint": "eslint src",
    "build": "tsc",
    "test": "npm run build && node --test test/scheduleTask.test.cjs test/calendarClient.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
